        "    elif to_anormal and ts_anormal:\n",
        "        clasificacion = 'Patológico'\n",
        "    else:\n",
        "        clasificacion = 'Borderline'\n",
        "\n",
        "    return {\n",
        "        'to_individual'   : to_arr,\n",
        "        'ts_individual'   : ts_arr,\n",
        "        'to_medio'        : float(to_medio),\n",
        "        'ts_medio'        : float(ts_medio) if not np.isnan(ts_medio) else np.nan,\n",
