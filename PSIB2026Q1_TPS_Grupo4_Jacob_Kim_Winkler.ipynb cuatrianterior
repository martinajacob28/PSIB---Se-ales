        "def medir_ancho_qrs(señal, pico, fs, umbral_fraccion=0.15,\n",
        "                    max_ancho_ms=250):\n",
        "    hw      = int(max_ancho_ms / 2 * fs / 1000)\n",
        "    ini     = max(0, pico - hw)\n",
        "    fin     = min(len(señal), pico + hw)\n",
        "    ventana = señal[ini:fin]\n",
        "    amp     = np.max(np.abs(ventana))\n",
        "    if amp < 1e-9:\n",
        "        return 0.0\n",
        "    umbral  = umbral_fraccion * amp\n",
        "    p_local = pico - ini\n",
        "    n_v     = len(ventana)\n",
        "    li = p_local\n",
        "    while li > 0 and np.abs(ventana[li]) >= umbral:\n",
        "        li -= 1\n",
        "    ld = p_local\n",
        "    while ld < n_v - 1 and np.abs(ventana[ld]) >= umbral:\n",
        "        ld += 1\n",
        "    return float(np.clip((ld - li) / fs * 1000, 0, max_ancho_ms))\n",
        "\n",
        "\n",
        "def medir_area_qrs(señal, pico, fs, ventana_ms=80):\n",
        "    hw  = int(ventana_ms / 2 * fs / 1000)\n",
        "    ini = max(0, pico - hw)\n",
        "    fin = min(len(señal), pico + hw)\n",
        "    return float(np.trapz(np.abs(señal[ini:fin])))\n",
        "\n",
        "\n",
        "def energia_onda_p(señal, pico, fs, ini_ms=250, fin_ms=80):\n",
        "    ini = max(0, pico - int(ini_ms * fs / 1000))\n",
        "    fin = max(0, pico - int(fin_ms  * fs / 1000))\n",
        "    if fin <= ini:\n",
        "        return 0.0\n",
        "    amp_qrs = np.max(np.abs(\n",
        "        señal[max(0, pico - int(50*fs/1000)):\n",
        "              min(len(señal), pico + int(50*fs/1000))]))\n",
        "    if amp_qrs < 1e-9:\n",
        "        return 0.0\n",
        "    return float(np.max(np.abs(señal[ini:fin])) / amp_qrs)\n",
        "\n",
        "\n",
        "def discordancia_onda_t(señal, pico, fs, ini_ms=150, fin_ms=400):\n",
        "    ini_t = min(len(señal), pico + int(ini_ms * fs / 1000))\n",
        "    fin_t = min(len(señal), pico + int(fin_ms * fs / 1000))\n",
        "    if fin_t <= ini_t or abs(señal[pico]) < 1e-9:\n",
        "        return 0.0\n",
        "    signo_qrs = np.sign(señal[pico])\n",
        "    media_t   = np.mean(señal[ini_t:fin_t])\n",
        "    return float(-signo_qrs * media_t)\n",
        "\n",
        "\n",
        "def pearson(a, b):\n",
        "    if np.std(a) < 1e-9 or np.std(b) < 1e-9:\n",
        "        return 1.0\n",
        "    return float(np.corrcoef(a, b)[0, 1])\n",
        "\n",
        "\n",
        "def construir_plantilla_y_stats(señal_c0, señal_c1, picos_r, fs,\n",
        "                                 hw, margen_rr=0.08, n_max=80):\n",
        "    rr     = np.diff(picos_r) / fs * 1000\n",
        "    rr_med = np.median(rr)\n",
        "    N      = len(picos_r)\n",
        "\n",
        "    idx_est = [\n",
        "        i for i in range(1, N-1)\n",
        "        if (1-margen_rr)*rr_med <= rr[i-1] <= (1+margen_rr)*rr_med\n",
        "    ]\n",
        "    idx_use = idx_est[:n_max] if len(idx_est) >= 10 \\\n",
        "              else list(range(1, min(41, N)))\n",
        "\n",
        "    def ex(sig, p):\n",
        "        i0 = max(0, p-hw); i1 = min(len(sig), p+hw)\n",
        "        lat = sig[i0:i1]\n",
        "        if len(lat) < 2*hw:\n",
        "            lat = np.pad(lat, (0, 2*hw-len(lat)), mode='edge')\n",
        "        return lat\n",
        "\n",
        "    lats0 = [ex(señal_c0, picos_r[i]) for i in idx_use]\n",
        "    lats1 = [ex(señal_c1, picos_r[i]) for i in idx_use]\n",
        "    pt0   = np.median(lats0, axis=0)\n",
        "    pt1   = np.median(lats1, axis=0)\n",
        "\n",
        "    def st(vals):\n",
        "        arr = np.array(vals)\n",
        "        return {'med': float(np.median(arr)),\n",
        "                'std': float(np.std(arr)+1e-9),\n",
        "                'p05': float(np.percentile(arr, 5)),\n",
        "                'p95': float(np.percentile(arr, 95))}\n",
        "\n",
        "    pu = [picos_r[i] for i in idx_use]\n",
        "    stats = {\n",
        "        'rr_med'  : rr_med,\n",
        "        'rr_std'  : float(np.std(rr)+1e-9),\n",
        "        'ancho0'  : st([medir_ancho_qrs(señal_c0, p, fs) for p in pu]),\n",
        "        'ancho1'  : st([medir_ancho_qrs(señal_c1, p, fs) for p in pu]),\n",
        "        'area0'   : st([medir_area_qrs(señal_c0,  p, fs) for p in pu]),\n",
        "        'area1'   : st([medir_area_qrs(señal_c1,  p, fs) for p in pu]),\n",
        "        'skew0'   : st([scipy_skew(ex(señal_c0, p)) for p in pu]),\n",
        "        'skew1'   : st([scipy_skew(ex(señal_c1, p)) for p in pu]),\n",
        "        'ep0'     : st([energia_onda_p(señal_c0, p, fs) for p in pu]),\n",
        "        'ep1'     : st([energia_onda_p(señal_c1, p, fs) for p in pu]),\n",
        "        'dt0'     : st([discordancia_onda_t(señal_c0, p, fs) for p in pu]),\n",
        "        'dt1'     : st([discordancia_onda_t(señal_c1, p, fs) for p in pu]),\n",
        "        'amp0'    : st([np.max(np.abs(l)) for l in lats0]),\n",
        "        'amp1'    : st([np.max(np.abs(l)) for l in lats1]),\n",
        "        'n_lat'   : len(idx_use),\n",
        "    }\n",
        "    return pt0, pt1, stats\n",
        "\n",
        "\n",
        "def extraer_features_latido(señal_c0, señal_c1, pico, picos_r, i,\n",
        "                              rr, fs, hw, pt0, pt1, stats):\n",
        "    N     = len(picos_r)\n",
        "    rr_m  = stats['rr_med']\n",
        "\n",
        "    idx_loc  = (list(range(max(1,i-8), i)) +\n",
        "                list(range(i+1, min(N-1,i+8))))\n",
        "    rr_local = rr[np.array(idx_loc)-1] if idx_loc else np.array([rr_m])\n",
        "    rr_med_l = np.median(rr_local)\n",
        "\n",
        "    rr_prev = rr[i-1]\n",
        "    rr_post = rr[i]\n",
        "    suma_rr = rr_prev + rr_post\n",
        "\n",
        "    def ex(sig):\n",
        "        i0 = max(0, pico-hw); i1 = min(len(sig), pico+hw)\n",
        "        lat = sig[i0:i1]\n",
        "        if len(lat) < 2*hw:\n",
        "            lat = np.pad(lat, (0, 2*hw-len(lat)), mode='edge')\n",
        "        return lat\n",
        "\n",
        "    lat0 = ex(señal_c0); lat1 = ex(señal_c1)\n",
        "\n",
        "    a0   = medir_ancho_qrs(señal_c0, pico, fs)\n",
        "    a1   = medir_ancho_qrs(señal_c1, pico, fs)\n",
        "    ar0  = medir_area_qrs(señal_c0,  pico, fs)\n",
        "    ar1  = medir_area_qrs(señal_c1,  pico, fs)\n",
        "    sk0  = scipy_skew(lat0); sk1 = scipy_skew(lat1)\n",
        "    ep0  = energia_onda_p(señal_c0, pico, fs)\n",
        "    ep1  = energia_onda_p(señal_c1, pico, fs)\n",
        "    dt0  = discordancia_onda_t(señal_c0, pico, fs)\n",
        "    dt1  = discordancia_onda_t(señal_c1, pico, fs)\n",
        "    c0v  = pearson(lat0, pt0); c1v = pearson(lat1, pt1)\n",
        "    amp0 = np.max(np.abs(lat0)); amp1 = np.max(np.abs(lat1))\n",
        "\n",
        "    def z(val, st_d): return (val - st_d['med']) / st_d['std']\n",
        "\n",
        "    return {\n",
        "        'rr_prev_norm' : rr_prev / (rr_med_l + 1e-9),\n",
        "        'rr_suma_norm' : suma_rr / (2 * rr_med_l + 1e-9),\n",
        "        'z_ancho0'     : z(a0,  stats['ancho0']),\n",
        "        'z_ancho1'     : z(a1,  stats['ancho1']),\n",
        "        'z_area0'      : z(ar0, stats['area0']),\n",
        "        'z_area1'      : z(ar1, stats['area1']),\n",
        "        'z_skew0'      : abs(z(sk0, stats['skew0'])),\n",
        "        'z_skew1'      : abs(z(sk1, stats['skew1'])),\n",
        "        'ep0_norm'     : ep0 / (stats['ep0']['med'] + 1e-9),\n",
        "        'ep1_norm'     : ep1 / (stats['ep1']['med'] + 1e-9),\n",
        "        'dt0_norm'     : dt0 / (abs(stats['dt0']['med']) + stats['dt0']['std'] + 1e-9),\n",
        "        'dt1_norm'     : dt1 / (abs(stats['dt1']['med']) + stats['dt1']['std'] + 1e-9),\n",
        "        'corr0'        : c0v,\n",
        "        'corr1'        : c1v,\n",
        "        'amp_rel0'     : amp0 / (stats['amp0']['med'] + 1e-9),\n",
        "        'amp_rel1'     : amp1 / (stats['amp1']['med'] + 1e-9),\n",
        "        '_rr_prev'     : rr_prev,\n",
        "        '_rr_med_l'    : rr_med_l,\n",
        "        '_suma_rr'     : suma_rr,\n",
        "        '_pico'        : pico,\n",
        "        '_idx'         : i,\n",
        "    }\n",
        "\n",
        "\n",
        "def calibrar_umbrales(feats_por_clase):\n",
        "    umbrales = {\n",
        "        'z_ancho_V'    : 2.5,\n",
        "        'z_ancho_A'    : 1.2,\n",
        "        'z_area_V'     : 2.5,\n",
        "        'z_area_A'     : 1.2,\n",
        "        'corr_V'       : 0.70,\n",
        "        'corr_A'       : 0.80,\n",
        "        'z_skew_V'     : 2.5,\n",
        "        'ep_A'         : 1.5,\n",
        "        'ep_V'         : 0.5,\n",
        "        'dt_V'         : 1.5,\n",
        "        'pausa_V'      : 1.80,\n",
        "        'pausa_A'      : 1.20,\n",
        "        'voto_V_min'   : 3.5,\n",
        "        'voto_A_min'   : 1.5,\n",
        "    }\n",
        "\n",
        "    clases_disp = set(feats_por_clase.keys())\n",
        "\n",
        "    def med(clase, feat):\n",
        "        vals = [f[feat] for f in feats_por_clase.get(clase, [])\n",
        "                if feat in f]\n",
        "        return np.median(vals) if len(vals) >= 2 else None\n",
        "\n",
        "    def std_comb(c1, c2, feat):\n",
        "        v1 = [f[feat] for f in feats_por_clase.get(c1, []) if feat in f]\n",
        "        v2 = [f[feat] for f in feats_por_clase.get(c2, []) if feat in f]\n",
        "        if not v1 or not v2:\n",
        "            return 0.0\n",
        "        return float(np.sqrt((np.std(v1)**2 + np.std(v2)**2) / 2 + 1e-9))\n",
        "\n",
        "    def umbral_entre(c1, c2, feat, default):\n",
        "        m1 = med(c1, feat); m2 = med(c2, feat)\n",
        "        if m1 is None or m2 is None:\n",
        "            return default\n",
        "        sc = std_comb(c1, c2, feat)\n",
        "        if abs(m1 - m2) < 0.3 * sc:\n",
        "            return default\n",
        "        return float((m1 + m2) / 2)\n",
        "\n",
        "    if 'V' in clases_disp and 'N' in clases_disp:\n",
        "        u = umbral_entre('N', 'V', 'z_ancho0', umbrales['z_ancho_V'])\n",
        "        if 1.5 <= u <= 4.0:\n",
        "            umbrales['z_ancho_V'] = u\n",
        "\n",
        "    if 'V' in clases_disp and 'N' in clases_disp:\n",
        "        u = umbral_entre('V', 'N', 'corr0', umbrales['corr_V'])\n",
        "        if 0.50 <= u <= 0.90:\n",
        "            umbrales['corr_V'] = u\n",
        "            umbrales['corr_A'] = min(u + 0.12, 0.95)\n",
        "\n",
        "    if 'V' in clases_disp and 'N' in clases_disp:\n",
        "        u = umbral_entre('N', 'V', 'z_area0', umbrales['z_area_V'])\n",
        "        if 1.5 <= u <= 4.0:\n",
        "            umbrales['z_area_V'] = u\n",
        "\n",
        "    if 'A' in clases_disp and 'V' in clases_disp:\n",
        "        u = umbral_entre('V', 'A', 'ep0_norm', umbrales['ep_A'])\n",
        "        if 0.8 <= u <= 3.0:\n",
        "            umbrales['ep_A'] = u\n",
        "\n",
        "    if 'A' in clases_disp and 'V' in clases_disp:\n",
        "        u = umbral_entre('A', 'V', 'rr_suma_norm', umbrales['pausa_V'])\n",
        "        if 1.4 <= u <= 2.2:\n",
        "            umbrales['pausa_V'] = u\n",
        "            umbrales['pausa_A'] = max(u - 0.55, 1.10)\n",
        "\n",
        "    n_V = len(feats_por_clase.get('V', []))\n",
        "    n_N = len(feats_por_clase.get('N', []))\n",
        "    if n_V > 0 and n_N > 0:\n",
        "        ratio_V = n_V / (n_N + n_V + 1e-9)\n",
        "        if ratio_V < 0.05:\n",
        "            umbrales['voto_V_min'] = max(2.5, umbrales['voto_V_min'] - 0.5)\n",
        "            print(f\"   Ajustado voto_V_min = {umbrales['voto_V_min']:.1f} \"\n",
        "                  f\"(ratio_V={ratio_V:.3f})\")\n",
        "\n",
        "    return umbrales\n",
        "\n",
        "\n",
        "def scoring_latido(f, umbrales):\n",
        "    votos_V = 0.0; votos_A = 0.0\n",
        "\n",
        "    z_a0 = f['z_ancho0']; z_a1 = f['z_ancho1']\n",
        "    z_ar0= f['z_area0'];  z_ar1= f['z_area1']\n",
        "    z_sk0= f['z_skew0'];  z_sk1= f['z_skew1']\n",
        "    c0   = f['corr0'];    c1   = f['corr1']\n",
        "    ep0  = f['ep0_norm']; ep1  = f['ep1_norm']\n",
        "    dt0  = f['dt0_norm']; dt1  = f['dt1_norm']\n",
        "    ar0  = f['amp_rel0']; ar1  = f['amp_rel1']\n",
        "    suma = f['rr_suma_norm']\n",
        "\n",
        "    uAV  = umbrales['z_ancho_V'];  uAA  = umbrales['z_ancho_A']\n",
        "    uArV = umbrales['z_area_V'];   uArA = umbrales['z_area_A']\n",
        "    ucV  = umbrales['corr_V'];     ucA  = umbrales['corr_A']\n",
        "    uepA = umbrales['ep_A'];       uepV = umbrales['ep_V']\n",
        "    udtV = umbrales['dt_V']\n",
        "    upV  = umbrales['pausa_V'];    upA  = umbrales['pausa_A']\n",
        "\n",
        "    if z_a0 > uAV and z_a1 > uAV:\n",
        "        votos_V += 2.0\n",
        "    elif z_a0 <= uAA or z_a1 <= uAA:\n",
        "        votos_A += 2.0\n",
        "\n",
        "    if z_ar0 > uArV and z_ar1 > uArV:\n",
        "        votos_V += 2.0\n",
        "    elif z_ar0 <= uArA or z_ar1 <= uArA:\n",
        "        votos_A += 1.0\n",
        "\n",
        "    if c0 < ucV and c1 < ucV:\n",
        "        votos_V += 2.0\n",
        "    elif c0 >= ucA or c1 >= ucA:\n",
        "        votos_A += 2.0\n",
        "    elif c0 < ucA and c1 < ucA:\n",
        "        votos_V += 1.0\n",
        "\n",
        "    if z_sk0 > umbrales.get('z_skew_V', 2.5) and \\\n",
        "       z_sk1 > umbrales.get('z_skew_V', 2.5):\n",
        "        votos_V += 1.0\n",
        "    elif z_sk0 <= 1.5 or z_sk1 <= 1.5:\n",
        "        votos_A += 0.5\n",
        "\n",
        "    if ep0 > uepA or ep1 > uepA:\n",
        "        votos_A += 2.0\n",
        "    elif ep0 < uepV and ep1 < uepV:\n",
        "        votos_V += 1.0\n",
        "\n",
        "    if dt0 > udtV and dt1 > udtV:\n",
        "        votos_V += 1.5\n",
        "    elif dt0 < 0.3 or dt1 < 0.3:\n",
        "        votos_A += 0.5\n",
        "\n",
        "    if suma >= upV:\n",
        "        votos_V += 1.5\n",
        "    elif upA <= suma < upV:\n",
        "        votos_A += 1.5\n",
        "\n",
        "    if ar0 > 1.4 or ar1 > 1.4:\n",
        "        votos_V += 0.5\n",
        "    elif 0.7 <= ar0 <= 1.3 and 0.7 <= ar1 <= 1.3:\n",
        "        votos_A += 0.5\n",
        "\n",
        "    return votos_V, votos_A\n",
        "\n",
        "\n",
        "def decidir_clase(f, votos_V, votos_A, umbrales):\n",
        "    z_a0 = f['z_ancho0']; z_a1 = f['z_ancho1']\n",
        "    ep0  = f['ep0_norm']; ep1  = f['ep1_norm']\n",
        "\n",
        "    qrs_estrecho = (z_a0 <= umbrales['z_ancho_A']) and \\\n",
        "                   (z_a1 <= umbrales['z_ancho_A'])\n",
        "    if qrs_estrecho:\n",
        "        votos_V *= 0.3\n",
        "\n",
        "    if (ep0 > umbrales['ep_A'] * 1.3 or\n",
        "            ep1 > umbrales['ep_A'] * 1.3) and votos_V < 5.0:\n",
        "        return 'A'\n",
        "\n",
        "    if votos_V >= umbrales['voto_V_min'] and votos_V > votos_A:\n",
        "        return 'V'\n",
        "    elif votos_A >= umbrales['voto_A_min'] or \\\n",
        "         (votos_A > 0 and votos_V < 2.0):\n",
        "        return 'A'\n",
        "    else:\n",
        "        return 'A'\n",
        "\n",
        "\n",
        "def detectar_ectopicos(señal_c0, señal_c1, picos_r, fs,\n",
        "                        pos_ref, sym_ref,\n",
        "                        ventana_ms=130):\n",
        "    ECTOPICOS_A = set('AaJSe')\n",
        "    ECTOPICOS_V = set('VEF')\n",
        "\n",
        "    rr  = np.diff(picos_r) / fs * 1000\n",
        "    N   = len(picos_r)\n",
        "    hw  = int(ventana_ms / 2 * fs / 1000)\n",
        "    tol = int(0.150 * fs)\n",
        "\n",
        "    labels = np.full(N, 'N', dtype='<U1')\n",
        "\n",
        "    pt0, pt1, stats = construir_plantilla_y_stats(\n",
        "        señal_c0, señal_c1, picos_r, fs, hw)\n",
        "\n",
        "    feats_todos = {}\n",
        "    for i in range(2, N - 1):\n",
        "        rr_prev = rr[i-1]\n",
        "        idx_loc = (list(range(max(1,i-8), i)) +\n",
        "                   list(range(i+1, min(N-1,i+8))))\n",
        "        rr_loc  = rr[np.array(idx_loc)-1] if idx_loc \\\n",
        "                  else np.array([stats['rr_med']])\n",
        "        rr_m    = np.median(rr_loc)\n",
        "\n",
        "        prem_rel = rr_prev < 0.82 * rr_m\n",
        "        prem_abs = (rr_m - rr_prev) > 55\n",
        "\n",
        "        if prem_rel and prem_abs:\n",
        "            feats_todos[i] = extraer_features_latido(\n",
        "                señal_c0, señal_c1, picos_r[i], picos_r, i,\n",
        "                rr, fs, hw, pt0, pt1, stats)\n",
        "\n",
        "    ref_usada       = np.zeros(len(pos_ref), dtype=bool)\n",
        "    feats_por_clase = {'N': [], 'A': [], 'V': []}\n",
        "\n",
        "    for i, f in feats_todos.items():\n",
        "        p     = picos_r[i]\n",
        "        dists = np.abs(pos_ref - p)\n",
        "        j     = np.argmin(dists)\n",
        "        if dists[j] <= tol and not ref_usada[j]:\n",
        "            ref_usada[j] = True\n",
        "            sym = sym_ref[j]\n",
        "            if sym in ECTOPICOS_V:\n",
        "                clase_ref = 'V'\n",
        "            elif sym in ECTOPICOS_A:\n",
        "                clase_ref = 'A'\n",
        "            else:\n",
        "                clase_ref = 'N'\n",
        "            feats_por_clase[clase_ref].append(f)\n",
        "\n",
        "    n_por_clase = {c: len(v) for c, v in feats_por_clase.items()}\n",
        "\n",
        "    umbrales = calibrar_umbrales(feats_por_clase)\n",
        "\n",
        "    for i, f in feats_todos.items():\n",
        "        vV, vA    = scoring_latido(f, umbrales)\n",
        "        labels[i] = decidir_clase(f, vV, vA, umbrales)\n",
        "\n",
        "    return labels, rr, pt0, pt1\n",
        "\n",
        "\n",
        "# Ejecutar ──────────────────────────────────────────────────────\n",
        "print(f\"Clasificando latidos del registro {registro_actual}...\")\n",
        "labels_det, rr_ms, plantilla_c0, plantilla_c1 = detectar_ectopicos(\n",
        "    c0_filt, c1_filt, picos_r, fs, pos_latidos, sym_latidos)\n",
        "\n",
        "idx_N = np.where(labels_det == 'N')[0]\n",
        "idx_A = np.where(labels_det == 'A')[0]\n",
        "idx_V = np.where(labels_det == 'V')[0]\n",
        "\n",
        "print(f\"\\nClasificación completada\")\n",
        "print(f\"   Total detectados         : {len(picos_r)}\")\n",
        "print(f\"   Normales         (N)     : {len(idx_N)}\")\n",
        "print(f\"   Ectópicos Atr.   (A)     : {len(idx_A)}\")\n",
        "print(f\"   Ectópicos Ventr. (V)     : {len(idx_V)}\")\n",
        "print(f\"   Suma N+A+V               : {len(idx_N)+len(idx_A)+len(idx_V)}  \"\n",
        "      f\"{'✅' if len(idx_N)+len(idx_A)+len(idx_V)==len(picos_r) else '❌'}\")\n",
        "\n",
        "# -Tacograma ─────────────────────────────────────────────────────\n",
        "tiempo_rr = picos_r[1:] / fs\n",
        "fig, ax = plt.subplots(figsize=(16, 4))\n",
        "ax.plot(tiempo_rr, rr_ms, color='#1f77b4', lw=0.7, alpha=0.7,\n",
        "        label='RR (ms)')\n",
        "ax.axhline(np.median(rr_ms), color='gray', ls='--', lw=1,\n",
        "           label=f'Mediana ({np.median(rr_ms):.0f} ms)')\n",
