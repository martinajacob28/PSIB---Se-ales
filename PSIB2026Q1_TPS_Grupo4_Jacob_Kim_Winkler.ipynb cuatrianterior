      "cell_type": "code",
      "source": [
        "# CELDA 8 — Identificación de PVC que cumplen Criterios de Schmidt\n",
        "\n",
        "def identificar_pvc_schmidt(picos_r, labels_det, fs,\n",
        "                              n_previos=5, n_posteriores=15,\n",
        "                              umbral_prematuridad=0.80,\n",
        "                              umbral_pausa=1.20,\n",
        "                              ventana_local=8):\n",
        "    \"\"\"\n",
        "    Identifica los PVC detectados que cumplen los Criterios de Schmidt.\n",
        "\n",
        "    Parámetros:\n",
        "        picos_r           : array de posiciones de picos R detectados\n",
        "        labels_det        : array de etiquetas ('N', 'A', 'V') por pico\n",
        "        fs                : frecuencia de muestreo\n",
        "        n_previos         : latidos previos que deben ser N (default 5)\n",
        "        n_posteriores     : latidos posteriores que deben ser N (default 15)\n",
        "        umbral_prematuridad: RR_previo < umbral × RR_medio_local\n",
        "        umbral_pausa      : RR_posterior > umbral × RR_medio_local\n",
        "        ventana_local     : latidos a cada lado para calcular RR medio local\n",
        "\n",
        "    Retorna:\n",
        "        schmidt_idx  : índices (en picos_r) de los PVC que cumplen\n",
        "        schmidt_info : lista de dicts con detalle de cada PVC Schmidt\n",
        "        resumen      : dict con estadísticas globales\n",
        "    \"\"\"\n",
        "    rr      = np.diff(picos_r) / fs * 1000   # intervalos RR en ms\n",
        "    N       = len(picos_r)\n",
        "    rr_global = np.median(rr)\n",
        "\n",
        "    schmidt_idx  = []\n",
        "    schmidt_info = []\n",
        "\n",
        "    # Índices de todos los V detectados\n",
        "    idx_V_todos = np.where(labels_det == 'V')[0]\n",
        "\n",
        "    for i in idx_V_todos:\n",
        "        # Necesitamos al menos n_previos latidos antes\n",
        "        # y n_posteriores + 1 después para tener RR post\n",
        "        if i < n_previos or i >= N - n_posteriores - 1:\n",
        "            continue\n",
        "        # Necesitamos RR previo y posterior\n",
        "        if i - 1 < 0 or i >= len(rr):\n",
        "            continue\n",
        "\n",
        "        rr_prev = rr[i - 1]\n",
        "        rr_post = rr[i]\n",
        "\n",
        "        # RR medio local (±ventana_local latidos, excluyendo el V)\n",
        "        idx_loc  = (list(range(max(1, i - ventana_local), i)) +\n",
        "                    list(range(i + 1, min(N - 1, i + ventana_local + 1))))\n",
        "        rr_local = rr[np.array(idx_loc) - 1] if idx_loc \\\n",
        "                   else np.array([rr_global])\n",
        "        rr_med_l = float(np.median(rr_local))\n",
        "\n",
        "        # ── Criterio 1: Prematuridad ──────────────────────────────\n",
        "        c1_prematuridad = rr_prev < umbral_prematuridad * rr_med_l\n",
        "\n",
        "        # ── Criterio 2: Pausa compensatoria ───────────────────────\n",
        "        c2_pausa = rr_post > umbral_pausa * rr_med_l\n",
        "\n",
        "        # ── Criterio 3: Entorno sinusal limpio ────────────────────\n",
        "        # Ventana de n_previos latidos anteriores al V\n",
