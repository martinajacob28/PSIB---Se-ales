        "        j     = np.argmin(dists)\n",
        "\n",
        "        if dists[j] <= tol and not usados1[j]:\n",
        "            # AND: confirmado por ambos canales\n",
        "            fusionados.append(int(round((p0 + picos_c1[j]) / 2)))\n",
        "            calidades.append(99.0)   # máxima confianza\n",
        "            usados1[j] = True\n",
        "        else:\n",
        "            # Solo C0: aceptar solo si calidad es suficiente\n",
        "            q = calidad_local(integ_c0, p0, fs)\n",
        "            if q >= umbral_calidad:\n",
