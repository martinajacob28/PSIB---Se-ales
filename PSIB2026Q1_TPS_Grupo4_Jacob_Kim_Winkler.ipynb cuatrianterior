        "        refrac = int(np.clip(fraccion * rr_estimado, min_samp, max_samp))\n",
        "        if p - filtrados[-1] >= refrac:\n",
        "            rr_estimado = int(0.875 * rr_estimado + 0.125 * (p - filtrados[-1]))\n",
        "            filtrados.append(p)\n",
        "\n",
        "    return np.array(filtrados, dtype=int)\n",
        "\n",
        "\n",
        "def calidad_local(integ, pico, fs, ventana_ms=300):\n",
        "    \"\"\"\n",
        "    SNR local estimado como ratio entre el valor del pico\n",
