      "cell_type": "code",
      "source": [
        "# CELDA 3 - Filtros para los artefactos\n",
        "\n",
        "def preprocesar_ecg(señal, fs, f_low=0.5, f_high=45.0, f_notch=60.0, Q=30):\n",
        "    b_hp, a_hp = butter(2, f_low / (fs / 2), btype='high')\n",
        "    sig = filtfilt(b_hp, a_hp, señal)\n",
        "\n",
        "    f_high_adj = min(f_high, fs / 2 - 1)\n",
        "    b_lp, a_lp = butter(4, f_high_adj / (fs / 2), btype='low')\n",
        "    sig = filtfilt(b_lp, a_lp, sig)\n",
        "\n",
        "    if f_notch < fs / 2:\n",
        "        b_n, a_n = iirnotch(f_notch / (fs / 2), Q)\n",
        "        sig = filtfilt(b_n, a_n, sig)\n",
        "\n",
        "    return sig\n",
        "\n",
        "# Detectar frecuencia de red según fs\n",
        "f_notch = 60.0 if fs >= 250 else 50.0\n",
        "\n",
        "# Filtrado idéntico e independiente en ambos canales\n",
        "c0_filt = preprocesar_ecg(señal_c0, fs, f_notch=f_notch)\n",
        "c1_filt = preprocesar_ecg(señal_c1, fs, f_notch=f_notch)\n",
        "\n",
        "print(f\"Preprocesamiento completado.\")\n",
        "print(f\"Canal 0 ({record.sig_name[0]}): HP={0.5}Hz | LP=45Hz | Notch={f_notch}Hz\")\n",
        "print(f\"Canal 1 ({record.sig_name[1]})  : HP={0.5}Hz | LP=45Hz | Notch={f_notch}Hz\")\n",
        "\n",
        "# Visualización: RAW vs Filtrado ────────────────────────────────\n",
        "dur = 10\n",
        "n   = dur * fs\n",
        "\n",
        "datos_vis = [\n",
        "    (señal_c0[:n], f'RAW — Canal 0 ({record.sig_name[0]})',      '#aec6cf'),\n",
        "    (c0_filt[:n],  f'Filtrado — Canal 0 ({record.sig_name[0]})', '#1f77b4'),\n",
        "    (señal_c1[:n], f'RAW — Canal 1 ({record.sig_name[1]})',      '#ffd580'),\n",
        "    (c1_filt[:n],  f'Filtrado — Canal 1 ({record.sig_name[1]})', '#ff7f0e'),\n",
