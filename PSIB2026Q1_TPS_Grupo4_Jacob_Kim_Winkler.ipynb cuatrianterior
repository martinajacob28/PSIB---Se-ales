        "# CELDA 11 — Cálculo de Heart Rate Turbulence (HRT) Turbulence Onset (TO) y Turbulence Slope (TS)\n",
        "\n",
        "def calcular_to(rr_prev2, rr_prev1, rr_post1, rr_post2):\n",
        "    \"\"\"\n",
        "    Turbulence Onset (TO) en porcentaje.\n",
        "    TO = (RR+1 + RR+2 - RR-2 - RR-1) / (RR-2 + RR-1) × 100\n",
        "\n",
        "    Parámetros:\n",
        "        rr_prev2 : RR dos latidos antes del PVC  (RR-2)\n",
        "        rr_prev1 : RR un latido antes del PVC    (RR-1)\n",
        "        rr_post1 : RR un latido después del PVC  (RR+1)\n",
        "        rr_post2 : RR dos latidos después del PVC (RR+2)\n",
        "\n",
        "    Retorna TO en % (negativo = aceleración = normal)\n",
        "    \"\"\"\n",
        "    denominador = rr_prev2 + rr_prev1\n",
        "    if denominador < 1e-9:\n",
        "        return np.nan\n",
        "    return ((rr_post1 + rr_post2 - rr_prev2 - rr_prev1) /\n",
        "            denominador * 100.0)\n",
        "\n",
        "\n",
        "def calcular_ts(rr_post_15):\n",
        "    \"\"\"\n",
        "    Turbulence Slope (TS) en ms/latido.\n",
        "    Pendiente máxima de regresión lineal sobre cualquier ventana\n",
        "    de 5 RR consecutivos dentro de los 15 RR post-PVC.\n",
        "\n",
        "    Parámetros:\n",
        "        rr_post_15 : array de 15 RR posteriores al PVC (ms)\n",
        "\n",
        "    Retorna:\n",
        "        ts_max      : pendiente máxima encontrada (ms/latido)\n",
        "        idx_ventana : índice de inicio de la ventana óptima\n",
        "        pendientes  : array con todas las pendientes calculadas\n",
        "    \"\"\"\n",
        "    n        = len(rr_post_15)\n",
        "    tam_vent = 5\n",
        "    x        = np.arange(tam_vent, dtype=float)\n",
        "\n",
        "    # Precalcular denominador de regresión lineal (constante para\n",
        "    # todas las ventanas porque x siempre es [0,1,2,3,4])\n",
        "    x_mean  = x.mean()\n",
        "    ss_x    = np.sum((x - x_mean) ** 2)   # = 10.0 siempre\n",
        "\n",
        "    pendientes  = np.full(n - tam_vent + 1, np.nan)\n",
        "\n",
        "    for k in range(n - tam_vent + 1):\n",
        "        y      = rr_post_15[k : k + tam_vent]\n",
        "        y_mean = y.mean()\n",
        "        ss_xy  = np.sum((x - x_mean) * (y - y_mean))\n",
        "        pendientes[k] = ss_xy / ss_x   # pendiente de la regresión\n",
        "\n",
        "    # La TS es la pendiente MÁS POSITIVA (máxima deceleración)\n",
        "    if np.all(np.isnan(pendientes)):\n",
        "        return np.nan, -1, pendientes\n",
        "\n",
        "    idx_max = int(np.nanargmax(pendientes))\n",
        "    ts_max  = float(pendientes[idx_max])\n",
        "\n",
        "    return ts_max, idx_max, pendientes\n",
        "\n",
        "\n",
        "def calcular_hrt_registro(resultados_tacograma_reg):\n",
        "    \"\"\"\n",
        "    Calcula TO y TS para cada ventana individual y luego\n",
        "    el TO_medio y TS_medio del registro (promediando sobre\n",
        "    todas las ventanas Schmidt del paciente).\n",
        "\n",
        "    Parámetros:\n",
        "        resultados_tacograma_reg : dict con 'ventanas' (n_pvc × 22)\n",
        "\n",
        "    Retorna dict con:\n",
        "        to_individual  : TO de cada PVC Schmidt (array)\n",
        "        ts_individual  : TS de cada PVC Schmidt (array)\n",
        "        to_medio       : TO promediado (sobre la ventana promedio)\n",
        "        ts_medio       : TS sobre la ventana promedio\n",
        "        to_sd          : desvío estándar del TO individual\n",
        "        ts_sd          : desvío estándar del TS individual\n",
        "        clasificacion  : 'Normal' / 'Patológico' / 'Borderline'\n",
        "        detalle        : dict con valores intermedios\n",
        "    \"\"\"\n",
        "    ventanas = resultados_tacograma_reg['ventanas']   # (n_pvc, 22)\n",
        "    promedio = resultados_tacograma_reg['promedio']   # (22,)\n",
        "\n",
        "    # Índices dentro de la ventana de 22 puntos:\n",
        "    # ventana = [RR-5, RR-4, RR-3, RR-2, RR-1, RR+1, RR+2, RR+3...RR+17]\n",
        "    #  índices:   0     1     2     3     4      5     6      7 ... 21\n",
        "    IDX_PREV2 = 3   # RR-2\n",
        "    IDX_PREV1 = 4   # RR-1\n",
        "    IDX_POST1 = 5   # RR+1  (primer RR post-PVC = pausa compensatoria)\n",
        "    IDX_POST2 = 6   # RR+2\n",
        "    IDX_POST_INI = 7   # inicio de los 15 RR de recuperación\n",
        "    IDX_POST_FIN = 22  # fin (índice exclusivo)\n",
        "\n",
        "    # TO y TS individuales (por cada PVC Schmidt) ───────────────\n",
        "    to_list = []\n",
        "    ts_list = []\n",
        "\n",
        "    for v in ventanas:\n",
        "        to_v = calcular_to(v[IDX_PREV2], v[IDX_PREV1],\n",
        "                           v[IDX_POST1], v[IDX_POST2])\n",
        "        ts_v, _, _ = calcular_ts(v[IDX_POST_INI:IDX_POST_FIN])\n",
        "        to_list.append(to_v)\n",
        "        ts_list.append(ts_v)\n",
        "\n",
        "    to_arr = np.array(to_list, dtype=float)\n",
        "    ts_arr = np.array(ts_list, dtype=float)\n",
        "\n",
        "    # TO y TS sobre la ventana PROMEDIADA ───────────────────────\n",
        "    # (más robusto al ruido respiratorio que el promedio de individuales)\n",
        "    to_medio = calcular_to(promedio[IDX_PREV2], promedio[IDX_PREV1],\n",
