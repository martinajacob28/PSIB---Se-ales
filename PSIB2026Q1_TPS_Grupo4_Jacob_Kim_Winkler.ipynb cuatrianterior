        "err_medio_ms   = np.mean(errores_pos)   / fs * 1000 if errores_pos else 0\n",
        "err_mediano_ms = np.median(errores_pos) / fs * 1000 if errores_pos else 0\n",
        "err_max_ms     = np.max(errores_pos)    / fs * 1000 if errores_pos else 0\n",
        "\n",
        "# Clasificación ─────────────────────────────────────────────────\n",
        "det_idx_m    = [p[0] for p in pares_qrs]\n",
        "ref_idx_m    = [p[1] for p in pares_qrs]\n",
        "labels_det_m = labels_det[det_idx_m]\n",
        "labels_ref_m = np.array([sym_to_nav(s) for s in sym_latidos[ref_idx_m]])\n",
