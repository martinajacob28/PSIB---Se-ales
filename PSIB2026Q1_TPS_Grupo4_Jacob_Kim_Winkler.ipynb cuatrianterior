      "source": [
        "# CELDA 7 - Aplicación de todos los pasos de preprocesamiento en TODO el dataset\n",
        "\n",
        "def pipeline_completo(record_path, registro_nombre):\n",
        "    ECTOPICOS_A = set('AaJSe')\n",
        "    ECTOPICOS_V = set('VEF')\n",
        "    NORMALES    = set('NLRejnBFf')\n",
        "    TODOS       = NORMALES | ECTOPICOS_A | ECTOPICOS_V\n",
        "    try:\n",
        "        record   = wfdb.rdrecord(record_path)\n",
        "        annot    = wfdb.rdann(record_path, 'atr')\n",
        "        fs       = record.fs\n",
        "        n_can    = record.p_signal.shape[1]\n",
        "        señal_c0 = record.p_signal[:, 0]\n",
        "        señal_c1 = record.p_signal[:, 1] if n_can > 1 else señal_c0.copy()\n",
        "\n",
        "        mask    = np.isin(np.array(annot.symbol), list(TODOS))\n",
        "        pos_ref = annot.sample[mask]\n",
        "        sym_ref = np.array(annot.symbol)[mask]\n",
        "\n",
        "        f_notch = 60.0 if fs >= 250 else 50.0\n",
        "        c0_f    = preprocesar_ecg(señal_c0, fs, f_notch=f_notch)\n",
        "        c1_f    = preprocesar_ecg(señal_c1, fs, f_notch=f_notch)\n",
        "\n",
        "        pk0, ig0 = pan_tompkins_single(c0_f, fs)\n",
        "        pk1, ig1 = pan_tompkins_single(c1_f, fs)\n",
        "        pk0 = ajuste_fino_picos(pk0, c0_f, fs)\n",
        "        pk1 = ajuste_fino_picos(pk1, c1_f, fs)\n",
        "        picos_r = fusionar_and_or(pk0, pk1, ig0, ig1, fs)\n",
        "\n",
        "        if len(picos_r) < 5:\n",
        "            return {'registro': registro_nombre, 'error': 'Muy pocos picos'}\n",
        "\n",
        "        labels_det, rr_ms, _, _ = detectar_ectopicos(\n",
        "            c0_f, c1_f, picos_r, fs, pos_ref, sym_ref)\n",
        "\n",
        "        TP_q, FP_q, FN_q, pares = match_detecciones_referencia(\n",
        "            picos_r, pos_ref, tolerancia_ms=150, fs=fs)\n",
        "        m_qrs = calcular_metricas_binarias(TP_q, FP_q, FN_q)\n",
        "\n",
        "        errores = [abs(int(picos_r[p[0]])-int(pos_ref[p[1]])) for p in pares]\n",
        "        err_ms  = np.mean(errores)/fs*1000 if errores else 0\n",
        "\n",
        "        d_idx = [p[0] for p in pares]\n",
        "        r_idx = [p[1] for p in pares]\n",
        "        ld_m  = labels_det[d_idx]\n",
        "        lr_m  = np.array([sym_to_nav(s) for s in sym_ref[r_idx]])\n",
        "\n",
        "        cm  = confusion_matrix(lr_m, ld_m, labels=['N','A','V'])\n",
        "        rep = classification_report(lr_m, ld_m, labels=['N','A','V'],\n",
        "                                    output_dict=True, zero_division=0)\n",
        "\n",
        "        return {\n",
        "            'registro' : registro_nombre,\n",
        "            'n_ref'    : len(pos_ref),\n",
        "            'n_det'    : len(picos_r),\n",
        "            'n_N_ref'  : int(np.sum(lr_m=='N')),\n",
        "            'n_A_ref'  : int(np.sum(lr_m=='A')),\n",
        "            'n_V_ref'  : int(np.sum(lr_m=='V')),\n",
        "            'n_N_det'  : int(np.sum(ld_m=='N')),\n",
        "            'n_A_det'  : int(np.sum(ld_m=='A')),\n",
        "            'n_V_det'  : int(np.sum(ld_m=='V')),\n",
        "            'FP_qrs'   : FP_q, 'FN_qrs': FN_q,\n",
        "            'Se_qrs'   : m_qrs['Se'], 'Pp_qrs': m_qrs['Pp'],\n",
        "            'F1_qrs'   : m_qrs['F1'], 'err_ms': err_ms,\n",
        "            'Se_A'     : rep.get('A',{}).get('recall',    0),\n",
        "            'Pp_A'     : rep.get('A',{}).get('precision', 0),\n",
        "            'F1_A'     : rep.get('A',{}).get('f1-score',  0),\n",
        "            'Se_V'     : rep.get('V',{}).get('recall',    0),\n",
        "            'Pp_V'     : rep.get('V',{}).get('precision', 0),\n",
        "            'F1_V'     : rep.get('V',{}).get('f1-score',  0),\n",
        "            'F1_macro' : rep.get('macro avg',{}).get('f1-score', 0),\n",
        "            'cm'       : cm, 'error': None\n",
        "        }\n",
        "    except Exception as e:\n",
        "        return {'registro': registro_nombre, 'error': str(e)}\n",
        "\n",
        "\n",
        "print(\"🔄 Procesando todos los registros...\\n\")\n",
        "resultados_todos = []\n",
        "for i, reg in enumerate(registros):\n",
        "    print(f\"  ({i+1}/{len(registros)}) {reg} ...\", end=' ')\n",
        "    res = pipeline_completo(os.path.join(DATASET_PATH, reg), reg)\n",
        "    if res.get('error'):\n",
        "        print(f\"❌ {res['error']}\")\n",
        "    else:\n",
        "        print(f\"✅  Se={res['Se_qrs']:.3f}  \"\n",
        "              f\"F1_A={res['F1_A']:.3f}  F1_V={res['F1_V']:.3f}\")\n",
        "    resultados_todos.append(res)\n",
        "\n",
        "ok = [r for r in resultados_todos if not r.get('error')]\n",
        "df = pd.DataFrame(ok).set_index('registro')\n",
        "\n",
        "# Tablas ────────────────────────────────────────────────────────\n",
        "print(\"\\n📋 TABLA DE CONTEOS\")\n",
        "t_cnt = df[['n_ref','n_det','FP_qrs','FN_qrs',\n",
        "             'n_N_ref','n_N_det','n_A_ref','n_A_det',\n",
        "             'n_V_ref','n_V_det']].copy()\n",
        "t_cnt.columns = ['Ref Tot','Det Tot','FP','FN',\n",
        "                  'N Ref','N Det','A Ref','A Det','V Ref','V Det']\n",
        "print(t_cnt.to_string())\n",
        "\n",
        "print(\"\\n📊 TABLA DE MÉTRICAS\")\n",
        "t_met = df[['Se_qrs','Pp_qrs','F1_qrs','err_ms',\n",
        "             'Se_A','Pp_A','F1_A','Se_V','Pp_V','F1_V',\n",
        "             'F1_macro']].round(4).copy()\n",
        "t_met.columns = ['Se QRS','Pp QRS','F1 QRS','Err(ms)',\n",
        "                  'Se A','Pp A','F1 A','Se V','Pp V','F1 V','F1 macro']\n",
        "print(t_met.to_string())\n",
        "\n",
        "print(f\"\\n{'='*65}\")\n",
        "print(f\"  ESTADÍSTICAS GLOBALES — {len(df)} registros\")\n",
        "print(f\"{'='*65}\")\n",
        "for col, label in [\n",
        "    ('Se_qrs',  'Sensibilidad QRS    '), ('Pp_qrs',  'Precisión QRS       '),\n",
        "    ('F1_qrs',  'F1 QRS              '), ('err_ms',  'Error posición (ms) '),\n",
        "    ('F1_A',    'F1 Ectópico Atrial  '), ('F1_V',    'F1 Ectóp. Ventricular'),\n",
        "    ('F1_macro','F1 Macro global     '),\n",
        "]:\n",
        "    v = df[col].dropna()\n",
        "    print(f\"  {label}: {v.mean():.4f}±{v.std():.4f} \"\n",
        "          f\"[{v.min():.4f}–{v.max():.4f}]\")\n",
        "\n",
        "# Métricas QRS por registro ─────────────────────────────────────\n",
        "regs = df.index.tolist()\n",
        "x    = np.arange(len(regs))\n",
        "\n",
        "fig, axes = plt.subplots(1, 3, figsize=(18, 5))\n",
        "for ax, col, titulo, color in zip(\n",
        "        axes, ['Se_qrs','Pp_qrs','F1_qrs'],\n",
        "        ['Sensibilidad QRS','Precisión QRS','F1-Score QRS'],\n",
        "        ['#1f77b4','#ff7f0e','#2ca02c']):\n",
        "    vals = df[col].values\n",
        "    ax.bar(x, vals, color=color, edgecolor='k', alpha=0.85, width=0.7)\n",
        "    ax.axhline(vals.mean(), color='navy', ls=':', lw=1.5,\n",
        "               label=f'Media: {vals.mean():.3f}')\n",
        "    ax.set_xticks(x); ax.set_xticklabels(regs, rotation=45, ha='right', fontsize=8)\n",
        "    ax.set_ylim(0, 1.08); ax.set_title(titulo, fontweight='bold')\n",
        "    ax.set_ylabel('Valor (0–1)')\n",
        "    ax.legend(fontsize=9); ax.grid(axis='y', ls='--', alpha=0.4)\n",
        "    ax.spines[['top','right']].set_visible(False)\n",
        "plt.suptitle('Métricas QRS — Todos los Registros',\n",
        "             fontsize=13, fontweight='bold')\n",
        "plt.tight_layout()\n",
        "plt.savefig('06a_metricas_qrs.png', bbox_inches='tight')\n",
        "plt.show()\n",
        "\n",
        "# Matrices de confusión acumuladas ─────────────────────────────\n",
        "cm_total = np.zeros((3,3), dtype=int)\n",
        "for r in ok:\n",
