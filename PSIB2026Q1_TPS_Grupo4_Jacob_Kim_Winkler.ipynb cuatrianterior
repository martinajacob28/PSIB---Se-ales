        "\n",
        "def sym_to_nav(symbol):\n",
        "    if symbol in set('NLRejnBFf'):\n",
        "        return 'N'\n",
        "    elif symbol in set('AaJSe'):\n",
        "        return 'A'\n",
        "    elif symbol in set('VEF'):\n",
        "        return 'V'\n",
        "    else:\n",
        "        return 'N'\n",
        "\n",
        "def match_detecciones_referencia(det_peaks, ref_peaks, tolerancia_ms=150, fs=360):\n",
        "    tol       = int(tolerancia_ms * fs / 1000)\n",
        "    ref_usada = np.zeros(len(ref_peaks), dtype=bool)\n",
        "    det_usada = np.zeros(len(det_peaks), dtype=bool)\n",
        "    pares     = []\n",
        "    for i, d in enumerate(det_peaks):\n",
        "        dists = np.abs(ref_peaks - d)\n",
        "        j     = np.argmin(dists)\n",
        "        if dists[j] <= tol and not ref_usada[j]:\n",
        "            pares.append((i, j))\n",
        "            ref_usada[j] = True\n",
        "            det_usada[i] = True\n",
        "    TP = len(pares)\n",
        "    FP = int(np.sum(~det_usada))\n",
        "    FN = int(np.sum(~ref_usada))\n",
        "    return TP, FP, FN, pares\n",
        "\n",
        "\n",
        "def calcular_metricas_binarias(TP, FP, FN):\n",
        "    Se  = TP / (TP + FN)   if (TP + FN) > 0 else 0.0\n",
        "    Pp  = TP / (TP + FP)   if (TP + FP) > 0 else 0.0\n",
        "    F1  = 2*Se*Pp/(Se+Pp)  if (Se+Pp)   > 0 else 0.0\n",
        "    FDR = FP / (TP + FP)   if (TP + FP) > 0 else 0.0\n",
        "    return {'Se': Se, 'Pp': Pp, 'F1': F1, 'FDR': FDR,\n",
        "            'TP': TP, 'FP': FP, 'FN': FN}\n",
        "\n",
        "\n",
        "# Detección QRS ─────────────────────────────────────────────────\n",
        "TP_q, FP_q, FN_q, pares_qrs = match_detecciones_referencia(\n",
        "    picos_r, pos_latidos, tolerancia_ms=150, fs=fs)\n",
