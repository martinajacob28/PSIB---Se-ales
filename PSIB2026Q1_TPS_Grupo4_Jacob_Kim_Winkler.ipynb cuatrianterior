        "# CELDA 4 — Pan-Tompkins\n",
        "\n",
        "def pan_tompkins_single(señal, fs):\n",
        "    \"\"\"\n",
        "    Pan-Tompkins sobre un canal. Retorna picos R y la señal\n",
        "    integrada (para estimar calidad local de detección).\n",
        "    \"\"\"\n",
        "    # 1. Pasa-banda 5–15 Hz\n",
        "    b_hp, a_hp = butter(2,  5.0 / (fs / 2), btype='high')\n",
        "    b_lp, a_lp = butter(2, 15.0 / (fs / 2), btype='low')\n",
        "    sig = filtfilt(b_hp, a_hp, señal)\n",
        "    sig = filtfilt(b_lp, a_lp, sig)\n",
        "\n",
        "    # 2. Derivada de 5 puntos\n",
        "    h     = np.array([-1, -2, 0, 2, 1]) * (fs / 8)\n",
        "    deriv = np.convolve(sig, h, mode='same')\n",
        "\n",
        "    # 3. Cuadrado\n",
        "    squared = deriv ** 2\n",
        "\n",
        "    # 4. Ventana móvil 150 ms\n",
        "    N_win  = int(0.150 * fs)\n",
        "    integ  = np.convolve(squared, np.ones(N_win) / N_win, mode='same')\n",
        "\n",
        "    # 5. Umbralización adaptativa\n",
        "    init_win = min(int(2 * fs), len(integ))\n",
        "    SPK = 0.5 * np.max(integ[:init_win])\n",
        "    NPK = 0.0\n",
        "    threshold = SPK\n",
        "    min_dist_init = int(0.200 * fs)\n",
        "\n",
        "    candidatos, _ = find_peaks(integ, distance=min_dist_init,\n",
        "                                height=0.15 * np.max(integ[:init_win]))\n",
        "    picos = []\n",
        "    for p in candidatos:\n",
        "        if integ[p] >= threshold:\n",
        "            picos.append(p)\n",
        "            SPK = 0.125 * integ[p] + 0.875 * SPK\n",
        "        else:\n",
        "            NPK = 0.125 * integ[p] + 0.875 * NPK\n",
        "        threshold = NPK + 0.25 * (SPK - NPK)\n",
        "\n",
        "    return np.array(picos, dtype=int), integ\n",
        "\n",
        "\n",
        "def ajuste_fino_picos(picos_raw, señal_filtrada, fs, half_win_ms=50):\n",
        "    \"\"\"\n",
        "    Reposiciona cada pico al máximo absoluto de la señal filtrada\n",
        "    dentro de una ventana ±half_win_ms alrededor del candidato.\n",
        "    \"\"\"\n",
        "    hw = int(half_win_ms * fs / 1000)\n",
        "    ajustados = []\n",
        "    for p in picos_raw:\n",
        "        ini = max(0, p - hw)\n",
        "        fin = min(len(señal_filtrada), p + hw)\n",
        "        p_aj = ini + np.argmax(np.abs(señal_filtrada[ini:fin]))\n",
        "        ajustados.append(int(p_aj))\n",
        "    return np.array(ajustados, dtype=int)\n",
        "\n",
        "\n",
        "def refractario_dinamico(picos, fs, fraccion=0.75, min_ms=200, max_ms=500):\n",
        "    \"\"\"\n",
        "    Elimina picos demasiado cercanos usando un período refractario\n",
        "    dinámico = fraccion × RR_medio_local (ventana de 5 latidos previos).\n",
        "    Esto se adapta a taquicardias y bradicardias.\n",
        "    \"\"\"\n",
        "    if len(picos) == 0:\n",
        "        return picos\n",
        "\n",
        "    min_samp = int(min_ms * fs / 1000)\n",
        "    max_samp = int(max_ms * fs / 1000)\n",
        "\n",
        "    filtrados = [picos[0]]\n",
        "    rr_estimado = int(0.800 * fs)   # inicialización 75 lpm\n",
        "\n",
