      "cell_type": "code",
      "source": [
        "\n",
        "# ==========================================\n",
        "# DISTRIBUCION DE CLASES EN MIT-BIH\n",
        "# ==========================================\n",
        "\n",
        "registros = [\n",
        "    '100', '101', '102', '103', '104', '105',\n",
        "    '106', '107', '108', '109', '111', '112',\n",
        "    '113', '114', '115', '116', '117', '118',\n",
        "    '119', '121', '122', '123', '124',\n",
        "    '200', '201', '202', '203', '205', '207',\n",
        "    '208', '209', '210', '212', '213', '214',\n",
        "    '215', '217', '219', '220', '221', '222',\n",
        "    '223', '228', '230', '231', '232',\n",
        "    '233', '234'\n",
        "]\n",
        "\n",
        "resultados = []\n",
        "\n",
        "for reg in registros:\n",
        "    anot = wfdb.rdann(reg, 'atr', pn_dir='mitdb')\n",
        "\n",
        "    simbolos = pd.Series(anot.symbol)\n",
        "    conteo = simbolos.value_counts()\n",
        "\n",
        "    resultados.append({\n",
        "        'Registro': reg,\n",
        "        'Normal (N)': conteo.get('N', 0),\n",
        "        'PAC (A)': conteo.get('A', 0),\n",
        "        'PVC (V)': conteo.get('V', 0)\n",
        "    })\n",
        "\n",
        "df_registros = pd.DataFrame(resultados)\n",
        "\n",
        "df_registros['Total N/A/V'] = (\n",
        "    df_registros['Normal (N)'] +\n",
        "    df_registros['PAC (A)'] +\n",
        "    df_registros['PVC (V)']\n",
        ")\n",
        "\n",
        "display(df_registros)\n",
        "\n",
        "print(\"\\nTotales por clase:\")\n",
        "print(df_registros[\n",
        "    ['Normal (N)', 'PAC (A)', 'PVC (V)']\n",
        "].sum())\n"
      ],
