        "# ==========================================\n",
        "# DETECCIÓN DE QRS - PAN-TOMPKINS\n",
        "# ==========================================\n",
        "\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "from scipy.signal import butter, filtfilt, find_peaks\n",
        "\n",
        "\n",
        "def pan_tompkins(ecg, fs):\n",
        "\n",
        "    # 1. Filtro pasa-banda 5-15 Hz\n",
        "    # Resalta principalmente la energía de los complejos QRS\n",
        "    b, a = butter(\n",
        "        2,\n",
        "        [5 / (fs / 2), 15 / (fs / 2)],\n",
        "        btype='band'\n",
        "    )\n",
        "\n",
        "    ecg_banda = filtfilt(\n",
        "        b,\n",
        "        a,\n",
        "        ecg\n",
        "    )\n",
        "\n",
        "    # 2. Derivada\n",
        "    # Resalta los cambios rápidos de amplitud\n",
        "    derivada = np.diff(\n",
        "        ecg_banda,\n",
        "        prepend=ecg_banda[0]\n",
        "    )\n",
        "\n",
        "    # 3. Elevación al cuadrado\n",
        "    # Hace positivos los valores y enfatiza los cambios grandes\n",
        "    cuadrada = derivada ** 2\n",
        "\n",
        "    # 4. Integración mediante ventana móvil de 150 ms\n",
        "    ventana = int(0.150 * fs)\n",
        "\n",
        "    integrada = np.convolve(\n",
        "        cuadrada,\n",
        "        np.ones(ventana) / ventana,\n",
        "        mode='same'\n",
        "    )\n",
        "\n",
        "    # 5. Umbral para detectar candidatos a QRS\n",
        "    # Se calcula a partir de la media y el desvío de la señal integrada\n",
        "    umbral = np.mean(integrada) + 0.5 * np.std(integrada)\n",
        "\n",
        "    # Distancia mínima entre complejos QRS\n",
        "    distancia_minima = int(0.25 * fs)\n",
        "\n",
        "    candidatos, propiedades = find_peaks(\n",
        "        integrada,\n",
        "        distance=distancia_minima,\n",
        "        height=umbral\n",
        "    )\n",
        "\n",
        "    # 6. Ajuste fino de la posición de cada pico R\n",
        "    # Se busca el máximo real del ECG filtrado alrededor\n",
        "    # de cada candidato detectado\n",
        "    picos_r = []\n",
        "\n",
        "    ventana_busqueda = int(0.08 * fs)\n",
        "\n",
        "    for pico in candidatos:\n",
        "\n",
        "        inicio = max(\n",
        "            0,\n",
        "            pico - ventana_busqueda\n",
        "        )\n",
        "\n",
        "        fin = min(\n",
        "            len(ecg),\n",
        "            pico + ventana_busqueda\n",
        "        )\n",
        "\n",
        "        segmento = ecg[inicio:fin]\n",
        "\n",
        "        posicion = inicio + np.argmax(\n",
        "            np.abs(segmento)\n",
        "        )\n",
        "\n",
        "        picos_r.append(posicion)\n",
        "\n",
        "    # Eliminamos posibles duplicados\n",
        "    picos_r = np.unique(\n",
        "        np.array(picos_r)\n",
        "    )\n",
        "\n",
        "    return picos_r, integrada"
      ],
