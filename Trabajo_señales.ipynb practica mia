    {
      "cell_type": "code",
      "source": [
        "# ==============================\n",
        "# PREPROCESAMIENTO\n",
        "# ==============================\n",
        "\n",
        "from scipy.signal import butter, filtfilt, iirnotch\n",
        "\n",
        "def filtrar_ecg(ecg, fs):\n",
        "\n",
        "    # Filtro pasa-altos: elimina deriva de línea de base\n",
        "    fc_high = 0.5\n",
        "    b_high, a_high = butter(\n",
        "        2,\n",
        "        fc_high / (fs / 2),\n",
        "        btype='high'\n",
        "    )\n",
        "    ecg_filtrado = filtfilt(b_high, a_high, ecg)\n",
        "\n",
        "    # Filtro pasa-bajos: reduce componentes de alta frecuencia\n",
        "    fc_low = 100\n",
        "    b_low, a_low = butter(\n",
        "        4,\n",
        "        fc_low / (fs / 2),\n",
        "        btype='low'\n",
        "    )\n",
        "    ecg_filtrado = filtfilt(b_low, a_low, ecg_filtrado)\n",
        "\n",
        "    # Filtro Notch: elimina interferencia de red a 60 Hz\n",
        "    f_notch = 60\n",
        "    Q = 30\n",
        "\n",
        "    b_notch, a_notch = iirnotch(\n",
        "        f_notch / (fs / 2),\n",
        "        Q\n",
        "    )\n",
        "\n",
        "    ecg_filtrado = filtfilt(\n",
        "        b_notch,\n",
        "        a_notch,\n",
        "        ecg_filtrado\n",
        "    )\n",
        "\n",
        "    return ecg_filtrado\n",
        "\n",
        "\n",
        "# Aplicamos los filtros al canal 0\n",
        "ecg_filtrado = filtrar_ecg(ecg_ch0, fs)\n",
        "\n",
        "print(\"Preprocesamiento finalizado\")"
      ],
